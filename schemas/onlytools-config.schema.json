{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ONLYTOOLS Product Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "repository",
    "release",
    "build"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "product": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "tagline",
        "category",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "legacyNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "beta",
            "development",
            "archived"
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architectures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "owner",
        "name",
        "url"
      ],
      "properties": {
        "owner": {
          "const": "onlytools-lab"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "tagPrefix",
        "assetNaming",
        "requireSha256"
      ],
      "properties": {
        "tagPrefix": {
          "const": "v"
        },
        "assetNaming": {
          "type": "string"
        },
        "requireSha256": {
          "type": "boolean"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "object"
        },
        "artifactsPath": {
          "type": "string"
        }
      }
    }
  }
}